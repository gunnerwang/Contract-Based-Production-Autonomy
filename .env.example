# ── Claude (default provider) ──────────────────────────────────────
# No API key needed — uses CLI authorization.
# Log in first:  claude login

# ── OpenAI (alternative provider) ─────────────────────────────────
# Set your API key here, then run with:  --provider openai
# OPENAI_API_KEY=sk-your-key-here

# Optional: custom base URL for OpenAI-compatible endpoints
# OPENAI_BASE_URL=https://your-endpoint.example.com/v1
